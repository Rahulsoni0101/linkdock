{
  "name": "linkdock",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @linkdock/api\" \"npm run dev -w @linkdock/web\"",
    "dev:api": "npm run dev -w @linkdock/api",
    "dev:web": "npm run dev -w @linkdock/web",
    "build": "npm run build -w @linkdock/web",
    "start": "npm run start -w @linkdock/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
